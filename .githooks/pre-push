#!/usr/bin/env bash
# .githooks/pre-push (MISSION V19 Phase 0 5e): never to main; secret scan of the tree; pins must match.
root=$(git rev-parse --show-toplevel) || exit 1
while read -r _ _ remote_ref _; do
  [ "$remote_ref" = "refs/heads/main" ] && { echo "pre-push: never push to main" >&2; exit 1; }
done
[ "$(git symbolic-ref --quiet --short HEAD)" = "main" ] && { echo "pre-push: branch is main" >&2; exit 1; }
python3 "$root/tools/redact.py" --tree || { echo "pre-push: secret scan found something" >&2; exit 1; }
python3 "$root/tools/check_pins.py" || { echo "pre-push: a pinned file changed without a PIN BUMP" >&2; exit 1; }
exit 0
