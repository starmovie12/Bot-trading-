#!/usr/bin/env bash
# .githooks/pre-commit (MISSION V19 Phase 0 5e): never on main; no data / recording / archive paths;
# secret scan of the staged blobs (path:line only, values never printed); ruff on the staged .py files.
root=$(git rev-parse --show-toplevel) || exit 1
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)
[ "$branch" = "main" ] && { echo "pre-commit: never commit to main" >&2; exit 1; }
staged=$(git diff --cached --name-only --diff-filter=ACMR)
bad=$(printf '%s\n' "$staged" | grep -E '^(data|recordings_private|state)/|\.(parquet|zip)$|\.csv\.gz$')
[ -n "$bad" ] && { printf 'pre-commit: data / recording path staged:\n%s\n' "$bad" >&2; exit 1; }
python3 "$root/tools/redact.py" --staged || { echo "pre-commit: secret-like name or content staged" >&2; exit 1; }
py=$(printf '%s\n' "$staged" | grep -E '\.py$' | grep -v '^archive/')
if [ -n "$py" ]; then
  # shellcheck disable=SC2086
  (cd "$root" && python3 -m ruff check --quiet $py) || { echo "pre-commit: ruff failed" >&2; exit 1; }
fi
exit 0
