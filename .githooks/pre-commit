#!/usr/bin/env bash
# .githooks/pre-commit (MISSION V11 T02a).
# 1. refuses commits on main; 2. secret guard on the STAGED blobs (names + content patterns,
# prints path:line only); 3. mission_check Tier 1 must be GREEN.
root=$(git rev-parse --show-toplevel) || exit 1
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)
if [ "$branch" = "main" ]; then
  echo "pre-commit: never commit to main (MISSION V11 §3). Commit refused." >&2
  exit 1
fi
if ! python3 "$root/tools/redact.py" --staged; then
  echo "pre-commit: secret-like file name or content staged (locations above; values never printed). Commit refused." >&2
  exit 1
fi
if ! out=$(python3 "$root/tools/mission_check.py" 2>&1); then
  printf '%s\n' "$out" >&2
  echo "pre-commit: mission_check is RED. Commit refused." >&2
  exit 1
fi
exit 0
